# Raw and processed datasets (exceed GitHub size limits)
# Keep folder hierarchy via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ignore local large datasets or excel files in root
*.parquet
*.xlsx
*.xls
